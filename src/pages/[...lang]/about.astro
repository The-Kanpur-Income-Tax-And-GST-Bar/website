---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getSite } from '../../lib/site';
import { getLang, langPaths, t } from '../../lib/i18n';
import { useUI } from '../../lib/ui';
import { story } from '../../lib/about';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const ui = useUI(lang);
const site = await getSite();
---
<Base lang={lang} path="about" title={ui('about.title')}>
  <PageHeader title={ui('about.title')} lead={`${t(site.name, lang)} ${ui('regd')}`} />
  <section class="section">
    <div class="wrap layout">
      <div class="story">
        <h2>{ui('about.story')}</h2>
        {story.map((paragraph) => <p>{t(paragraph, lang)}</p>)}
      </div>
      <aside class="card facts">
        <h2>{ui('about.facts')}</h2>
        <dl>
          <dt>{ui('about.established')}</dt>
          <dd>{site.established}</dd>
          <dt>{ui('about.registration')}</dt>
          <dd>{t(site.registered, lang)}</dd>
          <dt>{ui('about.office')}</dt>
          <dd>{t(site.address, lang)}</dd>
        </dl>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; gap: 2.5rem; }
  @media (min-width: 56rem) { .layout { grid-template-columns: 1fr 20rem; align-items: start; } }
  .facts { padding: 1.5rem; border-top: 3px solid var(--gold); }
  .facts h2 { font-size: 1.25rem; }
  dl { margin: 0; }
  dt { font-size: 0.8rem; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em; }
  :lang(hi) dt { text-transform: none; letter-spacing: 0; font-size: 0.9rem; }
  dd { margin: 0.15rem 0 1rem; }
</style>
