---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getCommittee } from '../../lib/site';
import { getLang, langPaths } from '../../lib/i18n';
import { useUI } from '../../lib/ui';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const ui = useUI(lang);
const people = await getCommittee();
const groups = [
  ['office', ui('committee.office')],
  ['appointed', ui('committee.appointed')],
  ['secretary', ui('committee.secretary')],
  ['executive', ui('committee.executive')],
] as const;
---
<Base lang={lang} path="committee" title={ui('committee.title')}>
  <PageHeader title={ui('committee.title')} lead={ui('committee.lead')} />
  {groups.map(([group, label]) => (
    <section class="section group">
      <div class="wrap">
        <h2>{label}</h2>
        <div class:list={['grid', { 'grid-people': group === 'office' }]}>
          {people.filter((p) => p.data.group === group).map((person) => (
            <PersonCard person={person} lang={lang} featured={group === 'office'} />
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .group + .group { padding-top: 0; }
</style>
