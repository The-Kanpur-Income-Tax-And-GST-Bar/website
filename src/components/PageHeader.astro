---
interface Props { title: string; lead?: string; eyebrow?: string }
const { title, lead, eyebrow } = Astro.props;
---
<section class="page-header">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header { background: linear-gradient(180deg, #fff, var(--paper)); border-bottom: 1px solid var(--line); padding-block: clamp(2rem, 6vw, 3.5rem) clamp(1.5rem, 4vw, 2.5rem); }
  .page-header h1 { margin-top: 0.5rem; }
  .lead { margin: 0; }
</style>
