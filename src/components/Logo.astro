---
/**
 * The Association emblem: advocate's bands on a black disc with the "Kanpur" ribbon.
 * Redrawn from the letterhead. `ring` adds the name around the edge (for large sizes only).
 */
interface Props { size?: number; ring?: boolean; class?: string }
const { size = 48, ring = false, class: className } = Astro.props;
const id = `ring-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={className} width={size} height={size} viewBox="0 0 120 120" role="img" aria-label="The Kanpur Income Tax and GST Bar Association emblem">
  <circle cx="60" cy="60" r="58" fill="#fff" />
  <circle cx="60" cy="60" r="56" fill="none" stroke="#14213d" stroke-width="2.5" />
  {ring && (
    <>
      <defs>
        <path id={id} d="M 60 60 m -46 0 a 46 46 0 1 1 92 0 a 46 46 0 1 1 -92 0" />
      </defs>
      <text font-family="'Source Sans 3', sans-serif" font-size="7.6" font-weight="700" letter-spacing="0.6" fill="#b3261e">
        <textPath href={`#${id}`} startOffset="1%" textLength="282" lengthAdjust="spacing">THE KANPUR INCOME TAX AND GST BAR ASSOCIATION (REGD.) ★</textPath>
      </text>
    </>
  )}
  <circle cx="60" cy="60" r={ring ? 38 : 50} fill="#111" />
  <g fill="#fff" transform={ring ? 'translate(60 60) scale(0.76) translate(-60 -60)' : undefined}>
    <rect x="45" y="24" width="30" height="8" rx="2" />
    <path d="M 50 32 L 58.5 32 L 56 88 L 42 88 Z" />
    <path d="M 61.5 32 L 70 32 L 78 88 L 64 88 Z" />
  </g>
  <g transform={ring ? 'translate(60 60) scale(0.72) translate(-60 -60) translate(0 2)' : undefined}>
    <path d="M 22 82 L 32 80 L 32 96 L 22 98 L 27 89 Z" fill="#8c1d17" />
    <path d="M 98 82 L 88 80 L 88 96 L 98 98 L 93 89 Z" fill="#8c1d17" />
    <path d="M 30 78 Q 60 86 90 78 L 90 94 Q 60 102 30 94 Z" fill="#b3261e" />
    <text x="60" y="93" text-anchor="middle" font-family="'Source Sans 3', sans-serif" font-size="11" font-weight="800" fill="#fff" letter-spacing="0.5">Kanpur</text>
  </g>
</svg>
